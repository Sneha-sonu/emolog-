{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Emotion Chatbot App",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run Text Chat Mode",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--text-chat"]
    }
  ]
}